rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // App data collections (public read/write for guest signups & tournament scoring)
    match /players/{playerId} {
      allow read, write: if true;
    }

    match /games/{gameId} {
      allow read, write: if true;
    }

    match /tournament_history/{historyId} {
      allow read, write: if true;
    }

    match /active_tournament/{docId} {
      allow read, write: if true;
    }

    match /match_setup/{docId} {
      allow read, write: if true;
    }

    // Access requests rules
    match /user_access_requests/{userId} {
      allow read, write: if true;
    }
  }
}
